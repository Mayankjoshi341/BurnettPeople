
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=burnettpeople
POSTGRES_USER=burnettpeople_user
POSTGRES_PASSWORD=change-this-local-password

# Local machine ports; Docker overrides these internally.
DB_HOST=127.0.0.1
DB_PORT=5433

REDIS_URL=redis://127.0.0.1:6380/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@burnettpeople.local
